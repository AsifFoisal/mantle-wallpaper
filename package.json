{
  "name": "mantle-wallpaper",
  "private": true,
  "version": "1.0.0",
  "description": "Mantle — interactive wallpaper & desktop organizer for Lively Wallpaper",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "npm run dev -w web",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w web && npm run build -w server",
    "start": "node server/dist/index.js",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w server",
    "install:lively": "powershell -ExecutionPolicy Bypass -File scripts/install-lively.ps1",
    "install:autostart": "powershell -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "uninstall:autostart": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-autostart.ps1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
